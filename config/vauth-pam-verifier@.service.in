[Unit]
Description=Lamellix Labs vAuth PAM verifier
Requires=vauth-pam-verifier.socket
After=vauth-pam-verifier.socket

[Service]
Type=exec
User=root
Group=root
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/vauth/vauthd pam-verifier
UMask=0077
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
KillMode=control-group
TimeoutStopSec=3s
